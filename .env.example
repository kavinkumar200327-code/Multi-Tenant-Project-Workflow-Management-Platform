# ==============================================================================
# Multi-Tenant Project & Workflow Management Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Backend/.env)
# ------------------------------------------------------------------------------
PROJECT_NAME="Multi-Tenant Project & Workflow Management Platform"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Database Connection (PostgreSQL with psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multi_tenant_workflow_db

# Security & JWT Token Generation
SECRET_KEY=replace_with_a_super_secret_jwt_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
